# Copy to .env.local for local-only values. Never commit .env.local.
E2E_BASE_URL=http://localhost:3100
# Set true with E2E_* owner/viewer values for a non-disposable server. Never
# run setup:local against an external or shared server.
E2E_EXTERNAL_SERVER=false
E2E_START_APP=false
# Set this only when the app can be started from this workspace.
# E2E_APP_COMMAND=npm run start

# Enable opt-in example coverage:
E2E_RUN_SMOKE=false
E2E_RUN_AUTH=false
E2E_RUN_PROFILE_READS=false
E2E_RUN_PROFILE_NAVIGATION=false
E2E_RUN_ACCESS_CONTROL=false
E2E_RUN_ACCESS_CONTROL_SERVER=false
E2E_ACCESS_CONTROL_RUNTIME_FILE=.access-control-runtime.json
E2E_PROFILE_URL=
E2E_POD_URL=
# Mutation tests must use a disposable profile, never a personal profile.
E2E_AUTH_STORAGE_STATE=
E2E_RUN_LOCAL_SETUP=false
E2E_RUN_LOCAL_PROFILE=false
# Reads .e2e-runtime.json to reuse the disposable IdP session created by setup.
E2E_USE_LOCAL_RUNTIME=false
E2E_RUNTIME_FILE=.e2e-runtime.json
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_POD_NAME=
E2E_VIEWER_POD_NAME=
# Required for the current local Pivot filesystem seed adapter.
# Example: /absolute/path/to/solidos/workspaces/pivot/data
E2E_PIVOT_DATA_ROOT=
# Optional seeded folder-pane data. `levels` contains one to three nested
# container URLs and `fileUrl` is a file in the deepest container.
# E2E_FOLDER_PANE_NESTED_CASE={"levels":["http://localhost:3000/pod/a/","http://localhost:3000/pod/a/b/"],"fileUrl":"http://localhost:3000/pod/a/b/file.ttl"}

# Test-only identities; use CI secret variables for real values.
E2E_OWNER_WEBID=https://example.invalid/profile/card#me
E2E_OWNER_USERNAME=
E2E_OWNER_PASSWORD=
E2E_VIEWER_WEBID=https://example.invalid/viewer/card#me
E2E_VIEWER_USERNAME=
E2E_VIEWER_PASSWORD=
# Optional second readable profile for friendship button coverage.
E2E_FRIEND_PROFILE_URL=
E2E_FRIEND_TARGET_WEBID=
